# ===== Obligatorias =====
# Cadena de conexión de Neon (Connect > "Connection pooling" activado), terminada en ?sslmode=verify-full
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=verify-full
# Secreto para firmar sesiones (texto largo y aleatorio)
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
# Primer administrador (solo se usa cuando la base está vacía)
ADMIN_EMAIL=admin@salesianostalca.cl
ADMIN_PASSWORD=UnaClaveSegura.2026

# ===== Correo (opcional: avisos y recuperación de contraseña) =====
# Cuenta en https://resend.com → API Keys
RESEND_API_KEY=
# Remitente verificado en Resend, por ejemplo: SIGPI <sigpi@salesianostalca.cl>
MAIL_FROM=
# Dirección pública de la app (para los enlaces de los correos)
APP_URL=https://sigpi-cest.vercel.app

# ===== Avisos automáticos (opcional) =====
# Secreto que protege /api/cron/avisos. Vercel lo envía solo si existe esta variable.
CRON_SECRET=

# ===== Otras =====
# Tamaño máximo de archivos de evidencia (MB)
MAX_UPLOAD_MB=4
# Zona horaria institucional para calcular "hoy"
TZ_INSTITUCION=America/Santiago
PORT=3000
