# Cadena de conexión de Neon (Dashboard > Connection Details > "Pooled connection")
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.sa-east-1.aws.neon.tech/sigpi?sslmode=require
# Secreto para firmar sesiones (cualquier texto largo y aleatorio)
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
# Primer administrador (solo se usa cuando la base está vacía)
ADMIN_EMAIL=admin@salesianostalca.cl
ADMIN_PASSWORD=UnaClaveSegura.2026
# Tamaño máximo de archivos de evidencia (MB). Para archivos más grandes, usar enlace a Drive.
MAX_UPLOAD_MB=4
PORT=3000
